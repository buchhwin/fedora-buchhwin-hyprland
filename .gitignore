# Machine-local state — never in a public repository.
*.log
*.bak
*.tmp
__pycache__/
.venv/

# Generated by theme/apply-theme.py into ~/.config, never into the repo.
# Listed anyway so an accidental copy cannot slip in.
colors.css
colors.rasi
theme.lua
theme.conf

# Personal wallpapers must never land in a public repository.
# Only the generated catppuccin-*.png are tracked; anything else you drop into
# wallpapers/ is ignored — bought or licensed images stay yours.
wallpapers/*
!wallpapers/catppuccin-*.png
!wallpapers/README.md

# Personal settings
settings.lua
settings.local.lua
.zshrc.local
