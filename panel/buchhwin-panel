#!/usr/bin/env bash
#
# Toggle one of the bar's popups.
#
#     buchhwin-panel calendar    month view and the day's appointments
#     buchhwin-panel audio       volume, mute, output device
#     buchhwin-panel network     connection status and Wi-Fi
#     buchhwin-panel quick       quick settings (the gear in the bar)
#     buchhwin-panel osd-volume  the on-screen bar, on the media keys
#     buchhwin-panel --daemon    the resident process (a user unit runs this)
#
# In the normal case this writes one line into a named pipe and exits, which
# costs about a millisecond. The window it toggles already exists, built once
# when the session started.
#
# That indirection is the entire point. Starting Python and GTK4 per click was
# measured at 1.1 seconds — 42 ms for Python, 518 ms for GTK4 and libadwaita,
# and the rest in layer-shell, CSS and the window. None of that is our code, so
# none of it can be tuned away; it can only be paid once.
#
# If the daemon is not running the popup is started directly instead. Slow, but
# a slow popup beats a click that does nothing.
set -euo pipefail

case "${1:-}" in
    calendar|audio|network|bluetooth|quick|overview|osd-volume|osd-brightness|osd-mic|--daemon) ;;
    *) echo "usage: buchhwin-panel calendar|audio|network|bluetooth|quick|overview|osd-volume|osd-brightness|osd-mic|--daemon" >&2; exit 2 ;;
esac

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
FIFO="${XDG_RUNTIME_DIR:-/tmp}/buchhwin-panel.fifo"

# gtk4-layer-shell has to be loaded before libwayland-client. A C program does
# that with linker order; an interpreter cannot, because importing gi pulls GTK
# — and therefore libwayland — in first. Without the preload every popup
# silently becomes an ordinary window: not anchored, not above tiled windows,
# no click-outside-to-close. It still appears, which is what makes it worth
# handling rather than ignoring.
#
# Resolved through ldconfig rather than hard-coded: the soname is what the
# dynamic linker looks for, and it knows where the file actually is.
preload() {
    if [[ -z "${LD_PRELOAD:-}" ]]; then
        local so
        so="$(ldconfig -p 2>/dev/null | awk '/libgtk4-layer-shell\.so/ {print $NF; exit}')"
        [[ -n "${so:-}" ]] && export LD_PRELOAD="$so"
    fi
}

if [[ "$1" == "--daemon" ]]; then
    preload
    exec python3 "$HERE/panel.py" --daemon
fi

# Writing to a pipe with no reader blocks forever, so never wait: if the daemon
# is not there, this must fail immediately and fall through.
if [[ -p "$FIFO" ]] && { true > "$FIFO"; } 2>/dev/null; then
    printf 'toggle %s\n' "$1" > "$FIFO"
    exit 0
fi

preload
exec python3 "$HERE/panel.py" "$1"
