# GENERATED by theme/apply-theme.py — do not edit.
# Flavour: {{flavour}} / accent: {{accent_name}}
#
# starship rather than powerlevel10k, for two reasons that matter here:
#   * p10k has been in limited support since 2024;
#   * p10k's config is a ~1700 line zsh script, which cannot be templated.
#     starship is one toml file, so the prompt recolours together with the
#     rest of the desktop instead of being the one thing left behind.
#
# The prompt is deliberately information-dense on the right and short on the
# left: on a wide terminal you see context, on a narrow SSH session you still
# have room to type.

format = """
[](fg:{{accent}})\
$os\
$username\
[](bg:{{surface1}} fg:{{accent}})\
$directory\
[](fg:{{surface1}} bg:{{surface0}})\
$git_branch\
$git_status\
[](fg:{{surface0}})\
$fill\
$cmd_duration\
$jobs\
$status\
$line_break\
$character"""

right_format = """$kubernetes$terraform$python$nodejs$rust$golang$java$docker_context$time"""

add_newline = true
palette = "catppuccin"

[palettes.catppuccin]
rosewater = "{{rosewater}}"
flamingo  = "{{flamingo}}"
pink      = "{{pink}}"
mauve     = "{{mauve}}"
red       = "{{red}}"
maroon    = "{{maroon}}"
peach     = "{{peach}}"
yellow    = "{{yellow}}"
green     = "{{green}}"
teal      = "{{teal}}"
sky       = "{{sky}}"
sapphire  = "{{sapphire}}"
blue      = "{{blue}}"
lavender  = "{{lavender}}"
text      = "{{text}}"
subtext1  = "{{subtext1}}"
subtext0  = "{{subtext0}}"
overlay2  = "{{overlay2}}"
overlay1  = "{{overlay1}}"
overlay0  = "{{overlay0}}"
surface2  = "{{surface2}}"
surface1  = "{{surface1}}"
surface0  = "{{surface0}}"
base      = "{{base}}"
mantle    = "{{mantle}}"
crust     = "{{crust}}"
accent    = "{{accent}}"

[fill]
symbol = " "

[os]
disabled = false
style = "bg:accent fg:crust"
format = "[ $symbol ]($style)"

[os.symbols]
Fedora = ""
Debian = ""
Ubuntu = ""
Arch   = ""
Linux  = ""

[username]
show_always = false          # only when it is not you: root, or over SSH
style_user = "bg:accent fg:crust"
style_root = "bg:red fg:crust"
format = '[ $user ]($style)'

[hostname]
ssh_only = true
style = "bg:accent fg:crust"
format = '[ $ssh_symbol$hostname ]($style)'

[directory]
style = "bg:surface1 fg:text"
format = "[ $path ]($style)"
truncation_length = 4
truncation_symbol = "…/"
read_only = "  "

[directory.substitutions]
"Documents" = " "
"Downloads" = " "
"Pictures"  = " "

[git_branch]
symbol = ""
style = "bg:surface0 fg:green"
format = '[ $symbol $branch ]($style)'

[git_status]
style = "bg:surface0 fg:peach"
format = '[$all_status$ahead_behind ]($style)'

[cmd_duration]
min_time = 2000
style = "fg:yellow"
format = "[  $duration ]($style)"

[jobs]
style = "fg:sapphire"
format = "[  $number ]($style)"

[status]
disabled = false
style = "fg:red"
format = "[ $symbol$status ]($style)"
symbol = " "

[character]
success_symbol = "[❯](bold green)"
error_symbol   = "[❯](bold red)"
vec_symbol     = "[❮](bold mauve)"

[time]
disabled = false
style = "fg:overlay1"
time_format = "%R"
format = "[  $time ]($style)"

# --- sysadmin context: only shown when it is actually relevant --------------
[kubernetes]
disabled = false
style = "fg:sapphire"
format = '[ 󱃾 $context(\($namespace\)) ]($style)'

[terraform]
style = "fg:mauve"
format = '[ 󱁢 $workspace ]($style)'

[docker_context]
style = "fg:blue"
format = '[  $context ]($style)'
only_with_files = true

[python]
style = "fg:yellow"
format = '[  $virtualenv ]($style)'

[nodejs]
style = "fg:green"
format = '[ 󰎙 $version ]($style)'

[rust]
style = "fg:peach"
format = '[ 󱘗 $version ]($style)'

[golang]
style = "fg:sky"
format = '[  $version ]($style)'

[java]
style = "fg:red"
format = '[  $version ]($style)'
