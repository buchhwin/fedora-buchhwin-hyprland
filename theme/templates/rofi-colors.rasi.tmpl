/* GENERATED by theme/apply-theme.py — do not edit.
 * Flavour: {{flavour}} / accent: {{accent_name}}
 *
 * config.rasi and the menu layouts import this, so every rofi menu — launcher,
 * window switcher, clipboard, emoji, wallpaper picker, keybind cheatsheet —
 * shares one look. */

* {
    base:      {{base}};
    mantle:    {{mantle}};
    crust:     {{crust}};
    surface0:  {{surface0}};
    surface1:  {{surface1}};
    surface2:  {{surface2}};
    overlay0:  {{overlay0}};
    overlay1:  {{overlay1}};
    text:      {{text}};
    subtext0:  {{subtext0}};
    subtext1:  {{subtext1}};

    rosewater: {{rosewater}};
    flamingo:  {{flamingo}};
    pink:      {{pink}};
    mauve:     {{mauve}};
    red:       {{red}};
    maroon:    {{maroon}};
    peach:     {{peach}};
    yellow:    {{yellow}};
    green:     {{green}};
    teal:      {{teal}};
    sky:       {{sky}};
    sapphire:  {{sapphire}};
    blue:      {{blue}};
    lavender:  {{lavender}};

    accent:    {{accent}};

    /* Translucent, matching the bar and the notification panel. */
    window-bg:  {{crust.ad9}};
    row-bg:     transparent;
    sel-bg:     {{accent}};
    sel-fg:     {{crust}};
    border-col: {{accent.a66}};
}
