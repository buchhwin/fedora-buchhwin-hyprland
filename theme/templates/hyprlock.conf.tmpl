# GENERATED by theme/apply-theme.py — do not edit.
# Flavour: {{flavour}} / accent: {{accent_name}}
#
# The lock screen is half of the first impression of a desktop, so it gets the
# same wallpaper as the session, blurred, with the palette on top.

general {
    hide_cursor = true
    grace = 0
    no_fade_in = false
}

background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 8
    noise = 0.0117
    contrast = 0.9
    brightness = 0.7
    vibrancy = 0.17
}

# --- clock -------------------------------------------------------------------
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgba({{text.hex}}ff)
    font_size = 110
    font_family = Inter SemiBold
    position = 0, 240
    halign = center
    valign = center
    shadow_passes = 2
    shadow_size = 4
    shadow_color = rgba({{crust.hex}}aa)
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    color = rgba({{subtext0.hex}}ff)
    font_size = 20
    font_family = Inter
    position = 0, 150
    halign = center
    valign = center
}

# --- who is logged in --------------------------------------------------------
image {
    monitor =
    path = $HOME/.face
    size = 110
    rounding = -1
    border_size = 3
    border_color = rgba({{accent.hex}}ff)
    position = 0, 20
    halign = center
    valign = center
}

label {
    monitor =
    text = $USER
    color = rgba({{text.hex}}ff)
    font_size = 16
    font_family = Inter Medium
    position = 0, -70
    halign = center
    valign = center
}

# --- password field ----------------------------------------------------------
input-field {
    monitor =
    size = 320, 52
    outline_thickness = 2
    dots_size = 0.26
    dots_spacing = 0.3
    dots_center = true
    rounding = 16

    outer_color = rgba({{accent.hex}}ff)
    inner_color = rgba({{surface0.hex}}dd)
    font_color  = rgba({{text.hex}}ff)
    check_color = rgba({{yellow.hex}}ff)
    fail_color  = rgba({{red.hex}}ff)

    placeholder_text = <span foreground="##{{subtext0.hex}}">Password</span>
    fail_text = <span foreground="##{{red.hex}}">$FAIL ($ATTEMPTS)</span>

    fade_on_empty = false
    position = 0, -140
    halign = center
    valign = center
}

# --- keyboard layout, only when there is more than one -----------------------
label {
    monitor =
    text = $LAYOUT
    color = rgba({{overlay1.hex}}ff)
    font_size = 12
    font_family = Inter
    position = 0, -200
    halign = center
    valign = center
}
