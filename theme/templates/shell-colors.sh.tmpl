# GENERATED by theme/apply-theme.py - do not edit.
# Flavour: {{flavour}} / accent: {{accent_name}}
#
# Sourced by ~/.zshrc. Everything here used to be hardcoded Mocha hex values in
# that file, which meant the shell stayed Catppuccin dark no matter which
# palette the desktop was using.

export FZF_DEFAULT_OPTS="
  --height 45% --layout=reverse --border=rounded --info=inline
  --color=bg+:{{surface0}},bg:{{base}},spinner:{{rosewater}},hl:{{red}}
  --color=fg:{{text}},header:{{red}},info:{{accent}},pointer:{{rosewater}}
  --color=marker:{{lavender}},fg+:{{text}},prompt:{{accent}},hl+:{{red}}
  --color=border:{{overlay0}}"

# bat reads a theme by NAME from its own cache; buchhwin.tmTheme is generated
# next to this file and the cache is rebuilt by apply-theme.py.
export BAT_THEME="buchhwin"

# eza colours the listing itself. da = date, di = directory, ex = executable.
export EZA_COLORS="da={{overlay1}}:di={{blue}}:ex={{green}}:fi={{text}}:ln={{teal}}:ur={{yellow}}:uw={{red}}:ux={{green}}"
