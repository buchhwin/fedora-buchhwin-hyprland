# GENERATED by theme/apply-theme.py - do not edit.
# Flavour: {{flavour}} / accent: {{accent_name}}
#
# GTK4 reads gsettings first, but not every application is on the session bus —
# Flatpaks and anything started outside the session fall back to this file. It
# did not exist at all before, so those applications kept GTK's defaults.
[Settings]
gtk-icon-theme-name={{icon_theme}}
gtk-cursor-theme-name={{cursor_theme}}
gtk-cursor-theme-size={{cursor_size}}
gtk-font-name=Inter 11
# NOT gtk-application-prefer-dark-theme: libadwaita warns that the key is
# unsupported and tells you to use AdwStyleManager:color-scheme, which is
# exactly what apply_gsettings() sets. Setting both means one warning per
# application start and no benefit.
gtk-decoration-layout={{button_layout}}
gtk-enable-animations=1
