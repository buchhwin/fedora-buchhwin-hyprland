/* GENERATED by theme/apply-theme.py — do not edit.
 * Flavour: {{flavour}} / accent: {{accent_name}}
 *
 * panel/style.css (hand-written, in the repo) is loaded alongside this file by
 * panel/popup.py, so layout and colour stay separate and a flavour switch
 * never touches the layout. */

@define-color base      {{base}};
@define-color mantle    {{mantle}};
@define-color crust     {{crust}};
@define-color surface0  {{surface0}};
@define-color surface1  {{surface1}};
@define-color surface2  {{surface2}};
@define-color overlay0  {{overlay0}};
@define-color text      {{text}};
@define-color subtext0  {{subtext0}};
@define-color subtext1  {{subtext1}};

@define-color red       {{red}};
@define-color green     {{green}};
@define-color yellow    {{yellow}};
@define-color blue      {{blue}};
@define-color mauve     {{mauve}};

@define-color accent    {{accent}};

/* Slightly more opaque than the bar's own pills: a popup carries text you are
 * meant to read and a slider you are meant to hit, so legibility beats seeing
 * the wallpaper through it. */
@define-color popupbg   rgba({{crust.rgb}}, 0.96);
