    },
    {
      "template": "shell-colors.sh.tmpl",
      "target": "$CONFIG/buchhwin/shell-colors.sh",
      "group": "shell"
    },
    {
      "template": "bat-theme.tmTheme.tmpl",
      "target": "$CONFIG/bat/themes/buchhwin.tmTheme",
      "group": "bat"
    },
    {
      "template": "lazygit.yml.tmpl",
      "target": "$CONFIG/lazygit/config.yml",
