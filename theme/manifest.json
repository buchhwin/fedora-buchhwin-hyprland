      "target": "$CONFIG/rofi/colors.rasi",
      "group": "rofi"
    },
    {
      "template": "kitty-theme.conf.tmpl",
      "target": "$CONFIG/kitty/theme.conf",
      "group": "kitty"
    },
    {
      "template": "wlogout-style.css.tmpl",
