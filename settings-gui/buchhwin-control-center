                 self.s.get("look.rounding", 12),
                 lambda v: self.s.set("look.rounding", int(v)))
        spin_row(g, _("Gap between windows"), _("Pixels"), 0, 40, 1,
                 self.s.get("look.gaps_in", 5),
                 lambda v: self.s.set("look.gaps_in", int(v)))
        spin_row(g, _("Gap to the screen edge"), _("Pixels"), 0, 60, 1,
                 self.s.get("look.gaps_out", 12),
                 lambda v: self.s.set("look.gaps_out", int(v)))

