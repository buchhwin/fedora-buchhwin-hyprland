class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        try:
            settings = Settings()
        except SystemExit as exc:
            # A broken settings.lua must produce a readable message, not a
            # traceback in a terminal nobody is looking at.
            dialog = Adw.MessageDialog(
                heading=_("Settings could not be read"),
                body=str(exc), modal=True)
            dialog.add_response("ok", _("Close"))
            dialog.connect("response", lambda *_a: self.quit())
            dialog.present()
            return
        Window(self, settings).present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
