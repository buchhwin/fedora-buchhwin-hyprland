class Window(Adw.ApplicationWindow):
    def __init__(self, app, settings: Settings):
        super().__init__(application=app, default_width=1000, default_height=720)
        self.s = settings
        self.set_title(_("Settings"))

        self.toasts = Adw.ToastOverlay()
        self.set_content(self.toasts)

        view = Adw.ToolbarView()
        self.toasts.set_child(view)

        header = Adw.HeaderBar()
        apply_btn = Gtk.Button(label=_("Apply"))
        apply_btn.add_css_class("suggested-action")
        apply_btn.connect("clicked", self.on_apply)
        header.pack_end(apply_btn)
        view.add_top_bar(header)

        self.stack = Adw.ViewStack()
        switcher = Adw.ViewSwitcher(stack=self.stack,
                                    policy=Adw.ViewSwitcherPolicy.WIDE)
        header.set_title_widget(switcher)
        view.set_content(self.stack)

        self._page_look()
        self._page_theme()
        self._page_keys()
        self._page_wallpaper()
        self._page_input()
        self._page_power()
        self._page_autostart()
        self._page_about()

    # -- helpers -------------------------------------------------------------
    def add_page(self, widget, name, title, icon):
        self.stack.add_titled_with_icon(widget, name, title, icon)

    def toast(self, text: str) -> None:
        self.toasts.add_toast(Adw.Toast(title=text, timeout=3))

    def on_apply(self, _btn=None):
        if not self.s.dirty:
            self.toast(_("Nothing to apply"))
            return
        self.s.apply()
        self.toast(_("Applied"))

    # -- pages ---------------------------------------------------------------
