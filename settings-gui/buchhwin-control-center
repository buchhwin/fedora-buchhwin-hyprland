#!/usr/bin/env python3
"""Buchhwin Control Center — the settings GUI.

Change how the desktop looks and behaves without opening a text editor: keys,
borders, gaps, blur, theme, wallpaper, drives, sound, network, displays, input,
idle timings and autostart.

How it talks to Hyprland
------------------------
It reads and writes ~/.config/hypr/settings.lua — plain data — and then runs
the generators that turn that file into a working desktop. It never parses
hand-written Lua, and it never edits hyprland.lua, binds.lua or rules.lua.

`hyprctl keyword` is not an option: with a Lua config provider it does not work
(hyprctl(1) says so outright). So "apply" means write the file and reload.

This file is only the entry point. Everything else lives in buchhwin_cc/ —
one module per settings page, plus the window, the shared widgets and the
settings store. It used to be a single file of 1392 lines.
"""

from __future__ import annotations

import gettext
import os
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw  # noqa: E402

APP_ID = "de.buchhwin.ControlCenter"
HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "buchhwin"

# English is the source language; German is a translation. fallback=True means
# a missing catalogue degrades to English rather than raising — a missing
# translation must never cost you the window. .install() puts _() into
# builtins, so every module below can use it without importing anything.
try:
    lang = (STATE / "lang").read_text().strip() if (STATE / "lang").exists() else None
except OSError:
    lang = None
gettext.translation("buchhwin-control-center",
                    localedir=str(HERE / "locale"),
                    languages=[lang] if lang else None,
                    fallback=True).install()

from buchhwin_cc.store import Settings  # noqa: E402
from buchhwin_cc.window import Window  # noqa: E402


class App(Adw.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID)
        self.settings = Settings()

    def do_activate(self) -> None:
        Window(self, self.settings).present()


if __name__ == "__main__":
    raise SystemExit(App().run(sys.argv))
