                  lambda v: self.s.set("theme.accent", v))

        row = Adw.ActionRow(
            title=_("Apply theme now"),
            subtitle=_("Re-renders every configuration and reloads what is running"))
        btn = Gtk.Button(label=_("Render"), valign=Gtk.Align.CENTER)
        btn.add_css_class("suggested-action")
        btn.connect("clicked", self._render_theme)
        row.add_suffix(btn)
        g.add(row)

        g2 = group(p, _("Wallpaper"), "")
        switch_row(g2, _("Wallpaper follows the flavour"),
                   _("Switching to Latte also picks a light wallpaper"),
                   self.s.get("wallpaper.follow_theme", True),
                   lambda v: self.s.set("wallpaper.follow_theme", v))

        self.add_page(p, "theme", _("Theme"), "applications-graphics-symbolic")

    def _render_theme(self, _btn):
        self.s.save()
        flavour = self.s.get("theme.flavour", "mocha")
        accent = self.s.get("theme.accent", "mauve")
        subprocess.run([sys.executable, str(REPO / "theme" / "apply-theme.py"),
                        "--flavour", flavour, "--accent", accent],
                       check=False)
        run("hyprctl", "reload")
        self.toast(_("Theme: {} / {}").format(flavour, accent))

    def _page_keys(self):
        p = page(_("Keys"), "input-keyboard-symbolic")
        self.keys_group = group(
            p, _("Key bindings"),
            _("Click a binding to record a new combination. Conflicts are "
              "flagged straight away."))
        self._rebuild_keys()
        self.add_page(p, "keys", _("Keys"), "input-keyboard-symbolic")

    def _rebuild_keys(self):
        while (child := self.keys_group.get_first_child()) is not None:
            # PreferencesGroup wraps its rows; remove only real rows.
            if isinstance(child, Adw.PreferencesRow):
                self.keys_group.remove(child)
            else:
                break
        for index, bind in enumerate(self.s.get("binds", []) or []):
            self.keys_group.add(self._key_row(index, bind))

    def _key_row(self, index: int, bind: dict) -> Adw.ActionRow:
        desc = bind.get("desc") or bind.get("arg", "")
        row = Adw.ActionRow(title=desc, subtitle=bind.get("arg", ""))
        label = Gtk.Label(label=bind.get("key", ""))
        label.add_css_class("dim-label")
        label.add_css_class("monospace")
        row.add_suffix(label)

        btn = Gtk.Button(icon_name="document-edit-symbolic",
                         valign=Gtk.Align.CENTER, tooltip_text=_("Record"))
        btn.add_css_class("flat")

        def record(_b):
            def captured(combo: str):
                clash = [b for i, b in enumerate(self.s.get("binds", []) or [])
                         if b.get("key") == combo and i != index]
                self.s.set(f"binds.{index}.key", combo)
                label.set_label(combo)
                if clash:
                    other = clash[0].get("desc") or clash[0].get("arg", "?")
                    self.toast(_("{} is already used for “{}”").format(combo, other))
                    label.add_css_class("error")
                else:
                    label.remove_css_class("error")
            KeyCaptureDialog(self, captured).present()

        btn.connect("clicked", record)
        row.add_suffix(btn)
        return row

    def _page_wallpaper(self):
        p = page(_("Wallpaper"), "preferences-desktop-wallpaper-symbolic")
        g = group(p, _("Wallpaper"), "")

        current = self.s.get("wallpaper.path", "") or _("(matching the flavour)")
        row = Adw.ActionRow(title=_("Current"), subtitle=current)
        pick = Gtk.Button(label=_("Choose…"), valign=Gtk.Align.CENTER)
        pick.connect("clicked", lambda _b: self._pick_wallpaper(row))
        row.add_suffix(pick)
        g.add(row)

        grid_btn = Adw.ActionRow(
            title=_("Thumbnail picker"),
            subtitle=_("The same grid as SUPER+W"))
        b = Gtk.Button(label=_("Open"), valign=Gtk.Align.CENTER)
        b.connect("clicked",
                  lambda _b: run(str(REPO / "scripts" / "wallpaper-menu.sh")))
        grid_btn.add_suffix(b)
        g.add(grid_btn)

        combo_row(g, _("Transition"), "",
                  ["grow", "wipe", "fade", "center", "outer", "random"],
                  self.s.get("wallpaper.transition", "grow"),
                  lambda v: self.s.set("wallpaper.transition", v))

        self.add_page(p, "wallpaper", _("Wallpaper"),
                      "preferences-desktop-wallpaper-symbolic")

    def _pick_wallpaper(self, row):
        dialog = Gtk.FileDialog(title=_("Choose a wallpaper"))
        images = Gtk.FileFilter()
        images.set_name(_("Images"))
        for pattern in ("*.jpg", "*.jpeg", "*.png", "*.webp"):
            images.add_pattern(pattern)
        dialog.set_default_filter(images)

        def done(dlg, result):
            try:
                gfile = dlg.open_finish(result)
            except GLib.Error:
                return
            path = gfile.get_path()
            if not path:
                return
            self.s.set("wallpaper.path", path)
            row.set_subtitle(path)
            subprocess.run([str(REPO / "scripts" / "wallpaper.sh"), "set", path],
                           check=False)

        dialog.open(self, None, done)

