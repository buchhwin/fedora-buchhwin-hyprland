// Waybar layout. Colours live in colors.css (generated); shapes in style.css.
//
// The bar is a floating island rather than an edge-to-edge strip: it reads as
// part of the desktop instead of a browser toolbar, and it leaves the corners
// of the wallpaper visible. Switch it in the settings if you prefer full width.
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 6,

    "modules-left":   ["custom/logo", "hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    // The right-hand side is a status area, not a dashboard. Four things you
    // act on — sound, network, battery, clock — each with a popup behind it,
    // the way Windows does it. cpu/memory/temperature used to sit here and are
    // gone on purpose: they are numbers you watch, not controls, and btop
    // shows them properly (SUPER+Escape). Bluetooth moved into the tray, which
    // is also where Windows keeps it.
    "modules-right":  ["tray", "custom/recording", "custom/drives",
                       "pulseaudio", "bluetooth", "network", "battery", "clock",
                       "custom/notifications", "custom/settings", "custom/power"],

    // One bar per screen, and each shows only its own workspaces. Without
    // all-outputs:false every screen shows every workspace, which defeats the
    // point of a fixed 1-5 / 6-10 assignment.
    "output": ["*"],

    // Windows opened from the bar run in their OWN scope, not in waybar's.
    // Waybar starts a click command as its child, so it lands in
    // buchhwin-bar.service's cgroup — and anything that restarts the bar then
    // takes that window with it. That is exactly how pressing Apply in the
    // settings window closed the settings window. Measured, not guessed: the
    // process was in cgroup buchhwin-bar.service.
    "custom/logo": {
        "format": "󰣛",
        "tooltip-format": "Applications — right click for categories",
        "on-click": "systemd-run --user --scope -q sh -c 'rofi -show drun'",
        "on-click-right": "systemd-run --user --scope -q sh -c '~/.local/share/fedora-buchhwin-hyprland/scripts/app-categories.sh'"
    },

    "hyprland/workspaces": {
        "all-outputs": false,
        // Number AND icon. The icon alone looked tidy but answered the wrong
        // question: you can see what a workspace is FOR without being able to
        // tell WHICH one you are on, and the keys are numbers.
        "format": "{id} {icon}",
        "format-icons": {
            "term": "󰆍", "web": "󰈹", "code": "󰨞", "mon": "󰍹", "chat": "󰭹",
            "default": "", "active": "", "urgent": ""
        },
        "on-click": "activate",
        // Lua syntax, not `hyprctl dispatch workspace e+1`. With a Lua config
        // provider hyprctl wraps the argument in hl.dispatch(...), so the old
        // form is a Lua syntax error and scrolling the workspaces did nothing
        // at all — silently, because hyprctl still exits 0.
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "persistent-workspaces": { "1": [], "2": [], "3": [], "4": [], "5": [] }
    },

    "hyprland/submap": {
        "format": "󰌌 {}",
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Brave": "󰈹 $1",
            "(.*) - Visual Studio Code": "󰨞 $1",
            "(.*) — Nemo": "󰉋 $1",
            "^$": "󰇄 Desktop"
        }
    },

    "tray": { "icon-size": 16, "spacing": 8 },

    // Only visible while wf-recorder is running, so you cannot forget you are
    // recording — a mistake that is expensive exactly once.
    "custom/recording": {
        "exec": "pgrep -x wf-recorder >/dev/null && echo '{\"text\":\"󰑊\",\"class\":\"recording\",\"tooltip\":\"Recording — SUPER+SHIFT+V to stop\"}' || echo '{}'",
        "return-type": "json",
        "interval": 2,
        "on-click": "~/.local/share/fedora-buchhwin-hyprland/scripts/record.sh"
    },

    // Left click opens the popup — that is the Windows gesture and the one
    // people reach for. Muting moved to the middle button; it used to be the
    // left click, and it is still one click, just not the one that now has a
    // more useful job. Scrolling to change the volume is unchanged.
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "headphone": "󰋋", "headset": "󰋎", "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "~/.local/share/fedora-buchhwin-hyprland/panel/buchhwin-panel audio",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "systemd-run --user --scope -q sh -c 'pavucontrol'",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "tooltip-format": "{desc}"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "~/.local/share/fedora-buchhwin-hyprland/panel/buchhwin-panel bluetooth",
        "on-click-right": "systemd-run --user --scope -q sh -c 'blueman-manager'"
    },

    // Ethernet shows the icon and nothing else. The interface name ("ens18",
    // "enp3s0") was pure noise: on a wired machine there is only one, and its
    // kernel name tells you nothing you did not already know. Wi-Fi keeps its
    // network name, because with several around that is the whole point.
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀 no IP",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-ethernet": "Wired · {ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Not connected",
        "on-click": "~/.local/share/fedora-buchhwin-hyprland/panel/buchhwin-panel network",
        "on-click-right": "systemd-run --user --scope -q sh -c 'nm-connection-editor'",
        "interval": 5
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 3,
        "on-click": "systemd-run --user --scope -q sh -c 'kitty -e btop'",
        "states": { "warning": 70, "critical": 90 }
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "tooltip-format": "{used:0.1f} GiB of {total:0.1f} GiB",
        "interval": 5,
        "on-click": "kitty -e btop",
        "states": { "warning": 75, "critical": 92 }
    },

    "temperature": {
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "critical-threshold": 82,
        "interval": 5,
        "tooltip": false
    },

    // Laptops only. Waybar's battery module finds nothing under
    // /sys/class/power_supply on a desktop and renders nothing, so this needs
    // no condition of its own — verified in a VM, which has no battery either.
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
        "states": { "warning": 25, "critical": 12 },
        "tooltip-format": "{timeTo}"
    },

    // Time AND date, like the Windows clock — the date was previously hidden
    // behind format-alt, where nobody found it. Clicking opens the calendar
    // popup, which shows the month and that day's appointments; the old
    // tooltip month-grid is gone because having both would be two answers to
    // the same question.
    "clock": {
        "format": "{:%H:%M  %a %d.%m.}",
        "tooltip": false,
        "on-click": "~/.local/share/fedora-buchhwin-hyprland/panel/buchhwin-panel calendar",
        "on-click-right": "systemd-run --user --scope -q sh -c 'gnome-calendar'"
    },

    // Only visible while something is mounted, so it costs no space on a
    // machine with no drives configured.
    "custom/drives": {
        "exec": "~/.local/share/fedora-buchhwin-hyprland/scripts/drives.py waybar",
        "return-type": "json",
        "interval": 30,
        "on-click": "systemd-run --user --scope -q sh -c 'nemo ~/Drives'",
        "escape": false
    },

    // Settings is where everything is configured, so it gets a permanent seat
    // rather than living only in the launcher — which is exactly how it stayed
    // undiscovered while it was also broken.
    "custom/settings": {
        "format": "󰒓",
        "tooltip-format": "Quick settings — right click opens the full window",
        // Left click opens the small panel; the full window is a button inside
        // it, and on the right button here. Six of the things people reach for
        // most are switches, and a switch does not deserve a sixteen-page
        // application.
        "on-click": "~/.local/share/fedora-buchhwin-hyprland/panel/buchhwin-panel quick",
        "on-click-right": "systemd-run --user --scope -q sh -c 'buchhwin-control-center'"
    },

    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚", "none": "󰂜",
            "dnd-notification": "󰂛", "dnd-none": "󰂛",
            "inhibited-notification": "󰂚", "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰂛"
        },
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true,
        "tooltip": false
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Session",
        "on-click": "wlogout"
    }
}
