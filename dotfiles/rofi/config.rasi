/* rofi 2.0 — one launcher for six jobs.
 *
 * rofi 2.0 merged the Wayland support that used to live in the rofi-wayland
 * fork, so this is the plain Fedora package.
 *
 * The same theme is used by the application launcher, window switcher,
 * clipboard history, emoji picker, wallpaper picker and keybind cheatsheet.
 * That shared look is most of what makes the desktop feel like one thing. */

@import "colors.rasi"
@import "menu.rasi"

configuration {
    modes: "drun,run,window,filebrowser";

    /* Categories, so a long list can be narrowed to the kind of thing you are
     * after. Only the ones that actually appear on a Fedora desktop are
     * listed; offering empty categories is worse than offering none.
     *
     * Deliberately NOT set as a filter here — that would HIDE everything
     * outside the category, which is the opposite of what a launcher is for.
     * Alt+1..8 switches, and scripts/search.sh (ALT+Space) searches across
     * everything regardless. */
    drun-show-actions: true;
    font: "Inter 12";

    drun-display-format: "{name}";
    display-drun:   "  Apps";
    display-run:    "  Run";
    display-window: "  Windows";
    display-filebrowser: "  Files";

    show-icons: true;
    icon-theme: "Papirus-Dark";

    /* Sort by how often you actually use things, not alphabetically. */
    sorting-method: "fzf";
    matching: "fuzzy";
    drun-match-fields: "name,generic,exec,categories,keywords";

    kb-cancel: "Escape,Super_L";
    terminal: "kitty";
}
