{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "layer-shell": true,
    "cssPriority": "user",

    "control-center-margin-top": 8,
    "control-center-margin-bottom": 8,
    "control-center-margin-right": 12,
    "control-center-margin-left": 0,
    "control-center-width": 420,
    "control-center-height": 640,

    "notification-2fa-action": true,
    "notification-inline-replies": true,
    "notification-icon-size": 48,
    "notification-body-image-height": 140,
    "notification-body-image-width": 200,
    "notification-window-width": 420,
    "timeout": 8,
    "timeout-low": 4,
    "timeout-critical": 0,
    "fit-to-screen": false,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 180,
    "hide-on-clear": true,
    "hide-on-action": true,

  // Group notifications by application. Ten build failures from one editor
  // should be one entry you can expand, not ten entries that push everything
  // else off the screen — which is exactly what happens without this.
  "notification-grouping": true,

  // Which notifications get to interrupt, per application. Everything not
  // listed behaves normally; these are the ones with a known habit.
  "notification-visibility": {
    // Screenshots announce themselves and then sit there. The file is already
    // in the clipboard and the folder, so the popup is pure noise — it stays
    // in the centre where it can be reviewed.
    "screenshot": {
      "state": "transient",
      "app-name": "Screenshot"
    },
    // Spotify's track changes are a stream, not events: one per song, forever.
    "music": {
      "state": "transient",
      "app-name": "(Spotify|spotify)"
    }
  },
    "script-fail-notify": true,

    "widgets": [
        "title",
        "dnd",
        "mpris",
        "volume",
        "backlight",
        "notifications"
    ],
    "widget-config": {
        "title": { "text": "Notifications", "clear-all-button": true, "button-text": "Clear all" },
        "dnd": { "text": "Do not disturb" },
        "mpris": { "image-size": 90, "image-radius": 12 },
        "volume": { "label": "󰕾", "show-per-app": true },
        "backlight": { "label": "󰃞", "device": "intel_backlight" }
    }
}
